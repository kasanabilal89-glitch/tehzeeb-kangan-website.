<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tehzeeb Kangan Restaurant | Kashmiri Food in Kangan, Kashmir</title>
<meta name="description" content="Tehzeeb Kangan Restaurant in Kangan, Kashmir. Wazwan, biryani, chicken dishes, fast food and more. View the menu and order on WhatsApp.">
<meta property="og:title" content="Tehzeeb Kangan Restaurant">
<meta property="og:description" content="Authentic taste, quality food and Kashmiri hospitality in Kangan, Kashmir.">
<meta property="og:type" content="restaurant">
<meta name="theme-color" content="#0B241B">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%2312372A'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle' fill='%23C8A049'%3ET%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
